# Debian image used by the client/server guests (required)
GUEST_IMAGE_PATH=/path/to/debian.qcow2

# Optional, defaults shown
#QEMU_BINARY=qemu-system-x86_64
#QEMU_IMG_BINARY=qemu-img
# Where VM disks (linked clones), pidfiles and QEMU command lines are stored. Wiped at the start of each experiment
#QEMU_WORK_DIR=experimentation/vms
# Without KVM, VMs are emulated (much slower) and routers use "-cpu max" instead of "-cpu host"
#QEMU_ENABLE_KVM=true
# auto: vhost-net when KVM, /dev/vhost-net and root/passwordless sudo (to create taps) are available, UDP tunnels otherwise
# on: vhost-net or fail, off: always UDP tunnels
#QEMU_VHOST=auto
# VirtIO NICs: number of queue pairs. auto: one per vCPU of the VM (each pair has its own vhost-net worker
# and guest interrupt, so multi-vCPU routers can spread packets over their vCPUs), off: single queue, N: N pairs
#QEMU_VIRTIO_QUEUES=auto
# auto: on multi-socket hosts, bind each VM (threads + memory) to one NUMA node with numactl; small topologies
# go entirely to the first node, large ones are split. off: no binding, N: every VM on node N
#QEMU_NUMA=auto
